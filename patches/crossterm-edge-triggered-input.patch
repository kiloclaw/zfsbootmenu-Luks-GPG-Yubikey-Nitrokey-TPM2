+/// Whether the terminal holds input not read yet (`FIONREAD`), without
+/// blocking: the descriptor is the terminal's own, which may block.
+#[cfg(not(feature = "libc"))]
+fn has_pending_input(fd: &FileDesc<'_>) -> bool {
+    rustix::io::ioctl_fionread(fd).is_ok_and(|count| count > 0)
+}
+
+/// Whether the terminal holds input not read yet (`FIONREAD`), without
+/// blocking: the descriptor is the terminal's own, which may block.
+#[cfg(feature = "libc")]
+fn has_pending_input(fd: &FileDesc<'_>) -> bool {
+    let mut count: libc::c_int = 0;
+    // SAFETY: FIONREAD writes one int to the pointer given.
+    let result = unsafe { libc::ioctl(fd.raw_fd(), libc::FIONREAD, &mut count) };
+    result == 0 && count > 0
+}
