+#[cfg(test)]
+mod case_patterns_tests {
+    use super::*;
+
+    /// The words of `input`, which holds one command substitution.
+    fn substitution(input: &str) -> String {
+        let tokens = tokenize_str(input).unwrap_or_else(|error| panic!("{input:?}: {error:?}"));
+        tokens.first().unwrap().to_str().to_owned()
+    }
+
+    #[test]
+    fn a_case_pattern_s_paren_does_not_close_a_command_substitution() {
+        let text = "$(\n  case a in\n    a|b)\n      echo one\n      ;;\n  esac\n)";
+        assert_eq!(substitution(text), text);
+        // On one line, with the optional `(`, `;&`, a last item without `;;`, and nested.
+        for text in [
+            "$(case $x in a) echo a;; *) echo b;; esac)",
+            "$(case $x in (a|b) echo a;; esac)",
+            "$(case $x in a) echo a;& b) echo b;; esac)",
+            "$(case $x in a) echo a\nesac)",
+            "$(case $x in a) case $y in b) echo b;; esac;; esac)",
+            "$(if true; then case $x in a) echo a;; esac; fi)",
+            "$(echo case in a)",
+            "$( (cd /; pwd) )",
+        ] {
+            assert_eq!(substitution(text), text, "{text}");
+        }
+    }
