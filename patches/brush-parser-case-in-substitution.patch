+}
+
+/// Where the tokens of a command substitution stand in its `case` commands, so that the `)`
+/// ending a pattern (`a|b)`) is told from the one closing the substitution, as bash tells
+/// them: a pattern list follows `case WORD in` and each `;;`, `;&` or `;;&`, and ends at its
+/// `)`; `esac` there, or at the start of a command, ends the `case`.
+#[derive(Debug, Default)]
+struct CasePatterns {
+    /// `case` commands not yet ended by `esac`.
+    open: u32,
+    /// Words of a `case` header seen: 1 after `case`, 2 after its subject.
+    header: u8,
+    /// Whether the tokens are a pattern list.
+    in_pattern: bool,
+    /// Whether a word of the current pattern list was seen.
+    pattern_started: bool,
+    /// Whether the next word starts a command.
+    command_start: bool,
+}
+
+impl CasePatterns {
+    /// Takes `token`; returns whether it is the optional `(` that opens a pattern, which does
+    /// not nest.
+    fn take(&mut self, token: &Token) -> bool {
+        match token {
+            // In a command substitution, blanks and newlines come as tokens of their own.
+            Token::Word(blank, _) if blank.trim().is_empty() => false,
+            Token::Operator(newline, _) if newline == "\n" => {
+                self.end_line();
+                false
+            }
+            // Kept with the blanks before them, which the substitution's text needs.
+            Token::Word(word, _) => {
+                self.take_word(word.trim());
+                false
+            }
+            Token::Operator(operator, _) => self.take_operator(operator.trim()),
+        }
+    }
+
+    fn take_word(&mut self, word: &str) {
+        if self.in_pattern {
+            if word == "esac" && !self.pattern_started {
+                self.open = self.open.saturating_sub(1);
+                self.in_pattern = false;
+                self.command_start = false;
+            } else {
+                self.pattern_started = true;
+            }
+            return;
+        }
+        match self.header {
+            1 => {
+                self.header = 2;
+                return;
+            }
+            2 => {
+                self.header = 0;
+                if word == "in" {
+                    self.in_pattern = true;
+                    self.pattern_started = false;
+                }
+                return;
+            }
+            _ => {}
+        }
+        if self.command_start && word == "case" {
+            self.open += 1;
+            self.header = 1;
+        } else if self.command_start && word == "esac" && self.open > 0 {
+            self.open -= 1;
+        }
+        // Reserved words after which a command starts.
+        self.command_start = matches!(
+            word,
+            "then" | "do" | "else" | "elif" | "if" | "while" | "until" | "{" | "!" | "time"
+        );
+    }
+
+    fn take_operator(&mut self, operator: &str) -> bool {
+        if self.in_pattern {
+            if operator == "(" && !self.pattern_started {
+                self.pattern_started = true;
+                return true;
+            }
+            return false;
+        }
+        if self.open > 0 && matches!(operator, ";;" | ";&" | ";;&") {
+            self.in_pattern = true;
+            self.pattern_started = false;
+            return false;
+        }
+        self.command_start = matches!(operator, ";" | "&" | "&&" | "||" | "|" | "(" | "|&");
+        false
+    }
+
+    /// A line ended: a command starts on the next, unless a pattern list goes on.
+    fn end_line(&mut self) {
+        if !self.in_pattern && self.header == 0 {
+            self.command_start = true;
+        }
+    }
+
+    /// Whether the `)` reached ends a pattern; a command starts after it.
+    fn end_pattern(&mut self) -> bool {
+        if self.in_pattern && self.pattern_started {
+            self.in_pattern = false;
+            self.command_start = true;
+            true
+        } else {
+            false
+        }
+    }
+}
