+/// The length in bytes of the body of the command substitution `text` holds after its `$(`, up
+/// to the `)` that closes it, as the tokenizer finds it (`case` patterns included); `None` when
+/// none closes it.
+pub(crate) fn command_substitution_body(text: &str) -> Option<usize> {
+    let mut reader = std::io::Cursor::new(text.as_bytes());
+    let mut tokenizer = Tokenizer::new(&mut reader, &TokenizerOptions::default());
+    let mut state = TokenParseState::new(&tokenizer.cross_state.cursor);
+    tokenizer
+        .consume_nested_construct(&mut state, ')', "(", 1)
+        .ok()?;
+    // The characters taken, the closing `)` last.
+    let taken = tokenizer.cross_state.cursor.index;
+    text.char_indices()
+        .nth(taken.checked_sub(1)?)
