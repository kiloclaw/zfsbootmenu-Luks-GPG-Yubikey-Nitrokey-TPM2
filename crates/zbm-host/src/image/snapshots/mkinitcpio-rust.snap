file	@/usr/share/zfsbootmenu/layouts/layouts	/usr/share/zfsbootmenu/layouts/layouts	0644
file	@/etc/inputrc	/etc/inputrc	0644
    | set input-meta on
    | set output-meta on
    | set convert-meta off
file	/usr/lib/locale/C.utf8/LC_CTYPE	/usr/lib/locale/C.utf8/LC_CTYPE	-
file	/usr/share/terminfo/x/xterm-256color	/usr/share/terminfo/x/xterm-256color	-
file	@/etc/zfsbootmenu/lock	/etc/zfsbootmenu/lock	0400
    | $argon2id$v=19$m=65536,t=3,p=4$c2FsdA$aGFzaA
binary	/usr/bin/brltty	/usr/bin/brltty
file	/usr/share/brltty/text.tbl	/usr/share/brltty/text.tbl	-
library	/usr/lib/brltty/libbrlttybba.so
module	usbhid	optional	any
module	cdc_acm	optional	any
module	ftdi_sio	optional	any
module	cp210x	optional	any
module	pl2303	optional	any
module	ch341	optional	any
module	speakup	required	any
module	speakup_soft	required	any
file	@/libexec/hooks/early-setup.d/05-screen-readers.sh	/libexec/hooks/early-setup.d/05-screen-readers.sh	0755
    | #!/bin/sh
    | ## Start the screen readers of the image, before anything is asked
    | ## (zfsbootmenu_brltty, zfsbootmenu_speakup).
    | brltty -q >/dev/null 2>&1 || true
    | modprobe speakup_soft >/dev/null 2>&1 || true
    | exit 0
