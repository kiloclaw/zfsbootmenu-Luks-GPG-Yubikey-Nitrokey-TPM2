    | #!/bin/bash
    | # vim: softtabstop=2 shiftwidth=2 expandtab
    | 
    | # Include guard
    | [ -n "${_ZFSBOOTMENU_CORE}" ] && return
    | readonly _ZFSBOOTMENU_CORE=1
    | 
    | # shellcheck disable=1091
    | if ! source /lib/zfsbootmenu-kcl.sh >/dev/null 2>&1; then
    |   zerror "failed to load KCL manipulation functions"
    |   exit 1
    | fi
    | 
    | # arg1: text with color sequences
    | # prints: text with color sequences removed
    | # returns: nothing
    | 
    | # Generated: the functions of this library run in zbm (ADR 0017).
    | _zbm_zfunc() {
    |   (
    |     export BASE BOOTFS CLEAR_SCREEN DRACUT_VERSION ENABLED FORCE_RELOAD HOME 2>/dev/null
    |     export ID ID_LIKE INITRD_VERSION NO_CACHE PRETTY_NAME PROMOTE PROPERTY 2>/dev/null
    |     export UNAME VALUE VERSION VERSION_ID ZBM_PRETTY_NAME ZBM_RELEASE_BUILD 2>/dev/null
    |     export ZBM_VERSION _pool adds allow_rw arg args beloc cache candidates cf 2>/dev/null
    |     export checkpoint cli_args color dataset decision def delay dev device 2>/dev/null
    |     export dtb_file dtb_prop dtb_try efivar_location efivar_state encroot 2>/dev/null
    |     export environment error_line ext f filesystem force_export fs grep_args 2>/dev/null
    |     export hdir hfile hook hook_envs hook_fs hook_mount hook_path hook_root 2>/dev/null
    |     export hostid hostid_re hsrc i id ifile import_args import_output 2>/dev/null
    |     export import_policy importable infinite inherited initramfs ipath k karg 2>/dev/null
    |     export kcl kcl_path kclfile kdir kern kern_kcl kernel kernel_list 2>/dev/null
    |     export kernel_records kexec_args key keycache keydest keydir keyfile 2>/dev/null
    |     export keyformat keylocation keypath keysource keysrc keystatus kkey kopt 2>/dev/null
    |     export kpath ksmount kval kver lbl lc level levels levels_array line 2>/dev/null
    |     export lines load_success loglevel mes message mnt mount_dev mount_path 2>/dev/null
    |     export mountpoint mounts mp mp_re mutex opt opts osrel ostype output 2>/dev/null
    |     export par_args parent parfs path pfx pool prefix prohibited prompt 2>/dev/null
    |     export read_write readargs recv_args relkeyloc rem rems ret 2>/dev/null
    |     export rewind_to_checkpoint roflag root_prefix rwo selected since single 2>/dev/null
    |     export snap snapshot spec_kexec_args specific_kernel spl_hostid splmod 2>/dev/null
    |     export state stype sup target target_parent trace val x y zbm_prefer_pool 2>/dev/null
    |     export zbm_set_hostid zfsbe zfsbe_fs zfsbe_mnt 2>/dev/null
    |     exec /libexec/zbm zfunc "$@"
    |   )
    | }
    | 
    | decolorize() {
    |   shopt -s extglob
    |   echo "${1//+(\\033\[[0-1];3[0-7]m|\\033\[0m|[[:cntrl:]]\[[0-1];3[0-7]m|[[:cntrl:]]\[0m)/}"
    |   shopt -u extglob
    | }
    | 
    | # arg1: color name
    | # arg2...argN: text to color
    | # prints: text with color escape codes
    | # returns: nothing
    | 
    | colorize() {
    |   local color
    |   color="${1}"
    |   shift
    |   case "${color}" in
    |     black)        echo -e -n '\033[0;30m' ;;
    |     red)          echo -e -n '\033[0;31m' ;;
    |     green)        echo -e -n '\033[0;32m' ;;
    |     orange)       echo -e -n '\033[0;33m' ;;
    |     blue)         echo -e -n '\033[0;34m' ;;
    |     magenta)      echo -e -n '\033[0;35m' ;;
    |     cyan)         echo -e -n '\033[0;36m' ;;
    |     lightgray)    echo -e -n '\033[0;37m' ;;
    |     darkgray)     echo -e -n '\033[1;30m' ;;
    |     lightred)     echo -e -n '\033[1;31m' ;;
    |     lightgreen)   echo -e -n '\033[1;32m' ;;
    |     yellow)       echo -e -n '\033[1;33m' ;;
    |     lightblue)    echo -e -n '\033[1;34m' ;;
    |     lightmagenta) echo -e -n '\033[1;35m' ;;
    |     lightcyan)    echo -e -n '\033[1;36m' ;;
    |     white)        echo -e -n '\033[1;37m' ;;
    |     *)            echo -e -n '\033[0m' ;;
    |   esac
    |   echo -e -n "$@"
    |   echo -e -n '\033[0m'
    | }
    | 
    | # arg1: text to center
    | # prints: left-padded text
    | # returns: nothing
    | 
    | center_string() {
    |   printf "%*s" $(( ( ${#1} + COLUMNS ) / 2 )) "${1}"
    | }
    | 
    | # arg1: hostid, as hex number without leading "0x"
    | # prints: nothing
    | # returns: 0 on successful write, 1 on error
    | 
    | write_hostid() {
    |   _zbm_zfunc write_hostid "$@"
    | }
    | 
    | # args: no arguments
    | # prints: hostid used by the SPL kmod, as hex with 0x prefix
    | # returns: 0 on successful read, 1 on failure
    | 
    | get_spl_hostid() {
    |   _zbm_zfunc get_spl_hostid "$@"
    | }
    | 
    | 
    | # arg1: optional specific pool to inspect
    | # prints: <imported pool>;<hostid>
    | # returns: 0 on successful pool import, 1 on failure
    | 
    | match_hostid() {
    |   _zbm_zfunc match_hostid "$@"
    | }
    | 
    | # args: no arguments
    | # prints: nothing
    | # returns: nothing
    | 
    | log_unimportable() {
    |   _zbm_zfunc log_unimportable "$@"
    | }
    | 
    | # args: none
    | # prints: nothing
    | # returns: 0 if at least one pool is available
    | 
    | check_for_pools() {
    |   _zbm_zfunc check_for_pools "$@"
    | }
    | 
    | # arg1: device name
    | # prints: mountpoint
    | # returns: 0 on success
    | 
    | mount_block() {
    |   _zbm_zfunc mount_block "$@"
    | }
    | 
    | # arg1: ZFS filesystem name
    | # prints: mountpoint
    | # returns: 0 on success
    | #
    | # If the filesystem is locked, this method fails without attempting unlock
    | 
    | mount_zfs() {
    |   _zbm_zfunc mount_zfs "$@"
    | }
    | 
    | # arg1: bootfs kernel initramfs
    | # prints: nothing
    | # returns: 1 on error, otherwise does not return
    | 
    | kexec_kernel() {
    |   _zbm_zfunc kexec_kernel "$@"
    | }
    | 
    | # arg1: snapshot name
    | # arg2: new BE name
    | # prints: nothing
    | # returns: 0 on success
    | 
    | duplicate_snapshot() {
    |   _zbm_zfunc duplicate_snapshot "$@"
    | }
    | 
    | # arg1: snapshot name
    | # arg2: new BE name
    | # arg3: prevents promotion if equal to "nopromote"; otherwise ignored
    | # prints: nothing
    | # returns: 0 on success
    | 
    | clone_snapshot() {
    |   _zbm_zfunc clone_snapshot "$@"
    | }
    | 
    | # arg1: filesystem name
    | # arg2: snapshot name
    | # prints: nothing
    | # returns: 0 on success
    | 
    | create_snapshot() {
    |   _zbm_zfunc create_snapshot "$@"
    | }
    | 
    | # arg1: snapshot name
    | # prints: nothing
    | # returns: 0 on success
    | 
    | rollback_snapshot() {
    |   _zbm_zfunc rollback_snapshot "$@"
    | }
    | 
    | # arg1: ZFS filesystem
    | # arg2: default kernel path (omit to unset default)
    | # prints: nothing
    | # returns: 0 on success, 1 otherwise
    | 
    | set_default_kernel() {
    |   _zbm_zfunc set_default_kernel "$@"
    | }
    | 
    | # arg1: ZFS filesystem
    | # prints: nothing
    | # returns: nothing
    | 
    | set_default_env() {
    |   _zbm_zfunc set_default_env "$@" || return
    |   BOOTFS="${1}"
    | }
    | 
    | # arg1: path of the kernel for which the initramfs is sought
    | # prints: path of a matching initramfs
    | # returns: 0 if initramfs was found, 1 otherwise
    | 
    | find_be_initramfs() {
    |   _zbm_zfunc find_be_initramfs "$@"
    | }
    | 
    | # arg1: ZFS filesystem
    | # prints: nothing
    | # returns: 0 if kernels were found, 1 otherwise
    | 
    | find_be_kernels() {
    |   _zbm_zfunc find_be_kernels "$@"
    | }
    | 
    | # arg1: ZFS filesystem
    | # prints: fs kernel initramfs
    | # returns: 0 if a kernel can be identified, 1 if not
    | 
    | select_kernel() {
    |   _zbm_zfunc select_kernel "$@"
    | }
    | 
    | # arg1: ZFS filesystem
    | # arg2: path for the mounted filesystem
    | # prints: discovered prefix for root= command-line argument
    | 
    | find_root_prefix() {
    |   _zbm_zfunc find_root_prefix "$@"
    | }
    | 
    | # arg1: ZFS KCL cache to validate
    | # returns: 0 if cache is valid, 1 otherwise
    | 
    | validate_cmdline_cache() {
    |   _zbm_zfunc validate_cmdline_cache "$@"
    | }
    | 
    | # arg1: ZFS filesystem
    | # arg2: optional path to kernel
    | # prints: path to kernel-specific KCL cache
    | # returns: 0 on success
    | 
    | kernel_kcl_cache() {
    |   _zbm_zfunc kernel_kcl_cache "$@"
    | }
    | 
    | # arg1: ZFS filesystem
    | # arg2: optional kernel to select
    | # prints: kernel command line arguments
    | # returns: nothing
    | 
    | load_be_cmdline() {
    |   _zbm_zfunc load_be_cmdline "$@"
    | }
    | 
    | # arg1: pool name, empty to import all
    | # prints: nothing
    | # returns: 0 on success, 1 on failure
    | 
    | # Accepted environment variables
    | # import_policy=force: enable force importing of a pool
    | # read_write=1: import read-write, defaults to read-only
    | # rewind_to_checkpoint=1: enable --rewind-to-checkpoint
    | 
    | import_pool() {
    |   _zbm_zfunc import_pool "$@"
    |   ret=$?
    |   [ "${ret}" -eq 0 ] || spl_hostid="$( _zbm_zfunc get_spl_hostid )"
    |   return "${ret}"
    | }
    | 
    | # arg1: pool name
    | # prints: nothing
    | # returns: 0 on success, 1 on failure
    | 
    | export_pool() {
    |   _zbm_zfunc export_pool "$@"
    |   ret=$?
    |   return "${ret}"
    | }
    | 
    | # arg1: pool name
    | # prints: nothing
    | # returns: 0 on success, 1 on failure
    | 
    | rewind_checkpoint() {
    |   _zbm_zfunc rewind_checkpoint "$@"
    | }
    | 
    | # prints: nothing
    | # returns: 0 if suspend device found, 1 otherwise
    | 
    | has_resume_device() {
    |   _zbm_zfunc has_resume_device "$@"
    | }
    | 
    | # getopts arguments:
    | # -d  prompt countdown/delay; negative values will wait forever
    | # -p  prompt with countdown timer (use %0.Xd as a placeholder for time)
    | # -m+ message to be printed above the prompt, usable multiple times
    | # -r  message to be prefixed with [RETURN] (accept)
    | # -e  message to be prefixed with [ESCAPE] (reject)
    | #
    | # -m, -r, -e are printed in the order they are passed to the function
    | 
    | timed_prompt() {
    |   local status
    |   _zbm_zfunc timed_prompt "$@"
    |   status=$?
    |   HEIGHT="$( tput lines 2>/dev/null )"
    |   WIDTH="$( tput cols 2>/dev/null )"
    |   return "${status}"
    | }
    | 
    | # arg1: pool name
    | # prints: warning message
    | # returns: 0 on success, 1 on failure
    | 
    | resume_prompt() {
    |   _zbm_zfunc resume_prompt "$@"
    | }
    | 
    | # arg1: filesystem name
    | # prints: nothing
    | # returns: 0 when filesystem is snapshot, 1 otherwise
    | 
    | is_snapshot() {
    |   local snapshot
    | 
    |   snapshot="${1}"
    |   if [ -z "${snapshot}" ]; then
    |     zerror "snapshot is undefined"
    |     return 1
    |   fi
    | 
    |   if [[ "${snapshot}" =~ @ ]]; then
    |     return 0
    |   else
    |     return 1
    |   fi
    | }
    | 
    | # arg1: pool name
    | # prints: nothing
    | # returns: 0 when pool is writable, 1 otherwise
    | 
    | # arg1: pool name
    | # prints: nothing
    | # returns: 0 if the pool is listed in ${BASE}/degraded, which restricts it to
    | #          read-only imports
    | 
    | is_degraded() {
    |   _zbm_zfunc is_degraded "$@"
    | }
    | 
    | is_writable() {
    |   _zbm_zfunc is_writable "$@"
    | }
    | 
    | # arg1: pool name
    | # prints: nothing
    | # returns: 0 on success, 1 on failure
    | 
    | set_rw_pool() {
    |   _zbm_zfunc set_rw_pool "$@"
    | }
    | 
    | # arg1: pool name
    | # prints: nothing
    | # returns: 0 on success, 1 on failure
    | 
    | set_ro_pool() {
    |   _zbm_zfunc set_ro_pool "$@"
    | }
    | 
    | 
