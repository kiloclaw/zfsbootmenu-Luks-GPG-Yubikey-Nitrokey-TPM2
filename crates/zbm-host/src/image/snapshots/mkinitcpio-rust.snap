    | #!/bin/bash
    | # vim: softtabstop=2 shiftwidth=2 expandtab
    | 
    | # Include guard
    | [ -n "${_ZFSBOOTMENU_KCL}" ] && return
    | readonly _ZFSBOOTMENU_KCL=1
    | 
    | # args: none
    | # prints: tokenization of KCL [read from stdin]: one argument per line
    | 
    | # Generated: the functions of this library run in zbm (ADR 0017).
    | _zbm_zfunc() {
    |   (
    |     export BASE BOOTFS CLEAR_SCREEN DRACUT_VERSION ENABLED FORCE_RELOAD HOME 2>/dev/null
    |     export ID ID_LIKE INITRD_VERSION NO_CACHE PRETTY_NAME PROMOTE PROPERTY 2>/dev/null
    |     export UNAME VALUE VERSION VERSION_ID ZBM_PRETTY_NAME ZBM_RELEASE_BUILD 2>/dev/null
    |     export ZBM_VERSION _pool adds allow_rw arg args beloc cache candidates cf 2>/dev/null
    |     export checkpoint cli_args color dataset decision def delay dev device 2>/dev/null
    |     export dtb_file dtb_prop dtb_try efivar_location efivar_state encroot 2>/dev/null
    |     export environment error_line ext f filesystem force_export fs grep_args 2>/dev/null
    |     export hdir hfile hook hook_envs hook_fs hook_mount hook_path hook_root 2>/dev/null
    |     export hostid hostid_re hsrc i id ifile import_args import_output 2>/dev/null
    |     export import_policy importable infinite inherited initramfs ipath k karg 2>/dev/null
    |     export kcl kcl_path kclfile kdir kern kern_kcl kernel kernel_list 2>/dev/null
    |     export kernel_records kexec_args key keycache keydest keydir keyfile 2>/dev/null
    |     export keyformat keylocation keypath keysource keysrc keystatus kkey kopt 2>/dev/null
    |     export kpath ksmount kval kver lbl lc level levels levels_array line 2>/dev/null
    |     export lines load_success loglevel mes message mnt mount_dev mount_path 2>/dev/null
    |     export mountpoint mounts mp mp_re mutex opt opts osrel ostype output 2>/dev/null
    |     export par_args parent parfs path pfx pool prefix prohibited prompt 2>/dev/null
    |     export read_write readargs recv_args relkeyloc rem rems ret 2>/dev/null
    |     export rewind_to_checkpoint roflag root_prefix rwo selected since single 2>/dev/null
    |     export snap snapshot spec_kexec_args specific_kernel spl_hostid splmod 2>/dev/null
    |     export state stype sup target target_parent trace val x y zbm_prefer_pool 2>/dev/null
    |     export zbm_set_hostid zfsbe zfsbe_fs zfsbe_mnt 2>/dev/null
    |     exec /libexec/zbm zfunc "$@"
    |   )
    | }
    | 
    | kcl_tokenize() {
    |   awk '
    |     BEGIN {
    |       strt = 1;
    |       quot = 0;
    |     }
    | 
    |     {
    |       for (i=1; i <= NF; i++) {
    |         # If an odd number of quotes are in this field, toggle quoting
    |         if ( gsub(/"/, "\"", $(i)) % 2 == 1 ) {
    |           quot = (quot + 1) % 2;
    |         }
    | 
    |         # Print a space if this is not the start of a line
    |         if (strt == 0) {
    |           printf " ";
    |         }
    | 
    |         printf "%s", $(i);
    | 
    |         if (quot == 0) {
    |           strt = 1;
    |           printf "\n";
    |         } else {
    |           strt = 0;
    |         }
    |       }
    |     }
    |   '
    | }
    | 
    | # arg1: ZFS filesystem
    | # prints: value of org.zfsbootmenu:commandline, with %{parent} recursively expanded
    | # returns: 0 on success
    | 
    | read_kcl_prop() {
    |   _zbm_zfunc read_kcl_prop "$@"
    | }
    | 
    | # arg1: ZFS filesystem
    | # arg2: path to command-line file (need not exist)
    | # prints: value of command line, with %{parent} expanded from ZFS property
    | # returns: 0 on success
    | 
    | read_kcl_value() {
    |   _zbm_zfunc read_kcl_value "$@"
    | }
    | 
    | # arg1..argN: keys (and, optionally, associated value) to suppress from KCL
    | # prints: tokenized KCL [read from stdin] with suppressed arguments removed
    | 
    | kcl_suppress() {
    |   local arg rem sup
    |   while read -r arg; do
    |     # Check match against all exclusions
    |     sup=0
    |     for rem in "$@"; do
    |       # Arguments match entirely or up to first equal
    |       if [[ "${arg}" == "${rem}" || "${arg%%=*}" == "${rem}" ]]; then
    |         sup=1
    |         break
    |       fi
    |     done
    | 
    |     # Echo argument if it was not suppressed
    |     [ "${sup}" -ne 1 ] && echo "${arg}"
    |   done
    | }
    | 
    | # args1..argN: keys (and values, as appropriate) to append to a tokenized KCL
    | # prints: tokenized KCL [read from stdin] with appended arguments
    | 
    | kcl_append() {
    |   local arg
    | 
    |   # Carry forward input KCL
    |   cat
    | 
    |   # Append one line per non-trivial argument
    |   for arg in "$@"; do
    |     [ -n "${arg}" ] && echo "$arg"
    |   done
    | }
    | 
    | 
    | # args: none
    | # prints: space-separated concatenation of tokenized KCL [read from stdin]
    | 
    | kcl_assemble() {
    |   awk '
    |     BEGIN{ strt = 1; }
    | 
    |     {
    |       if (strt == 0) {
    |         printf " ";
    |       }
    | 
    |       printf "%s", $0;
    |       strt = 0;
    |     }
    |   '
    | }
    | 
    | # args: none
    | # prints: tokenized KCL from /etc/cmdline, /etc/cmdline.d/*.conf and /proc/cmdline
    | 
    | _build_zbm_kcl() {
    |   _zbm_zfunc _build_zbm_kcl "$@"
    | }
    | 
    | # args: none
    | # prints: tokenized KCL, read from cache if possible or else built on demand
    | 
    | get_zbm_kcl() {
    |   _zbm_zfunc get_zbm_kcl "$@"
    | }
    | 
    | # args: none
    | # prints: nothing
    | # returns: nothing
    | 
    | make_cmdline_dir() {
    |   _zbm_zfunc make_cmdline_dir "$@"
    | }
    | 
    | # arg1..argN: argument to lookup (multiples are alternatives, ordered by precedence)
    | # prints: value associated with the argument (with no value, 1 is printed)
    | # returns: 0 if match is found, 1 otherwise
    | 
    | get_zbm_arg() {
    |   _zbm_zfunc get_zbm_arg "$@"
    | }
    | 
    | # arg1: default value (0 or 1)
    | # arg2..argN: argument to extract (all after first are alternatives)
    | # return: default if no match is found, 0 or 1 based on found value
    | 
    | get_zbm_bool() {
    |   _zbm_zfunc get_zbm_bool "$@"
    | }
    | 
    | # prints: ZBM kernel command line
    | 
    | zbmcmdline() {
    |   _zbm_zfunc zbmcmdline "$@"
    | }
