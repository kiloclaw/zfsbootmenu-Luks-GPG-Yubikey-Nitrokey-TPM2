file	@/etc/zfsbootmenu.conf	/etc/zfsbootmenu.conf	0644
    | # Include guard
    | [ -n "${_ETC_ZFSBOOTMENU_CONF}" ] && return
    | readonly _ETC_ZFSBOOTMENU_CONF=1
    | export HAS_REFRESH="1"
    | export HAS_DISABLED="1"
    | export HAS_BORDER="1"
    | export HAS_COLUMN="1"
    | export HAS_COLORS="1"
    | export HAS_RAW=""
    | export ZBM_BUILDSTYLE="mkinitcpio"
    | export ZBM_RELEASE_BUILD=""
    | export ZBM_RUNTIME="rust"
file	@/etc/profile	/etc/profile	0644
    | export PATH=/zbm/bin:/usr/sbin:/usr/bin:/sbin:/bin
    | [ "${TERM}" = dumb ] || export TERM=linux
    | export HOME=/root
    | export LC_CTYPE=C.UTF-8
    | [ "${ZBM_CONSOLE}" = drm ] && export TERM=xterm-256color
file	@/root/.bashrc	/root/.bashrc	0644
    | source /etc/zfsbootmenu.conf >/dev/null 2>&1
    | source /lib/kmsg-log-lib.sh >/dev/null 2>&1
    | source /lib/zfsbootmenu-core.sh >/dev/null 2>&1
    | source /lib/zfsbootmenu-kcl.sh >/dev/null 2>&1
    | [ -f /etc/profile ] && source /etc/profile
    | [ -f /lib/zfsbootmenu-completions.sh ] && source /lib/zfsbootmenu-completions.sh
    | 
    | export PROMPT_COMMAND="/libexec/recovery-error-printer"
    | export PS1='\[\033[0;33m\]zfsbootmenu\[\033[0m\] \w > '
    | 
    | alias clear="tput clear"
    | alias reset="tput reset"
    | alias trace="ztrace"
    | alias help="/libexec/zfsbootmenu-help -L recovery-shell"
    | 
    | zdebug "sourced /root/.bashrc" || true
    | 
    | # SSH logins get the shell that the runtime chose (zbm.shell)
    | if [ -n "${SSH_CONNECTION}" ] && [ -z "${BRUSH_VERSION}" ] \
    |   && shopt -q login_shell 2>/dev/null \
    |   && [ "$( cat "${BASE:-/zfsbootmenu}/shell" 2>/dev/null )" = /usr/bin/brush ]; then
    |   exec /usr/bin/brush
    | fi
link	/root/.bashrc	/root/.profile
file	@/lib/profiling-lib.sh	/lib/profiling-lib.sh	0644
    | return 0
