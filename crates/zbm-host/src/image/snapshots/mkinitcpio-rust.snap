    | # returns: 0 if the device is mounted, 1 if not
    | 
    | is_mounted() {
    |   mount_dev="${1}"
    |   _zbm_zfunc is_mounted "$@"
    | }
    | 
    | # args: none
    | # prints: nothing
    | # returns: 0 if EFI is detected, 1 if not
    | 
    | is_efi_system() {
    |   _zbm_zfunc is_efi_system "$@"
    | }
    | 
    | # arg1: 'ro' or 'rw' to mount or remount efivarfs in that desired mode
    | # arg2: optional mountpoint
    | # prints: nothing
    | # returns: 0 on success, 1 on failure, 2 if unsupported
    | 
    | mount_efivarfs() {
    |   _zbm_zfunc mount_efivarfs "$@"
    | }
    | 
    | # arg1: zfs dataset name
    | # returns: 0 if filesystem
    | 
    | is_zfs_filesystem() {
    |   _zbm_zfunc is_zfs_filesystem "$@"
    | }
    | 
    | # arg1: mount point
    | # returns: 0 if everything was unmounted, 1 if not
    | 
    | recursive_umount() {
    |   _zbm_zfunc recursive_umount "$@"
    | }
    | 
