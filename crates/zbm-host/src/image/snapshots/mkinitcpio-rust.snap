file	@/lib/kmsg-log-lib.sh	/lib/kmsg-log-lib.sh	0644
    | #!/bin/bash
    | # vim: softtabstop=2 shiftwidth=2 expandtab
    | 
    | if [ -n "${_ZFSBOOTMENU_KMSG_LOG_LIB}" ]; then
    |   [ -z "${FORCE_RELOAD}" ] && return
    | else
    |   readonly _ZFSBOOTMENU_KMSG_LOG_LIB=1
    | fi
    | 
    | : "${loglevel:=4}"
    | 
    | # arg1..argN: log line
    | # prints: nothing
    | # returns: 1 if loglevel isn't high enough
    | 
    | # Generated: the functions of this library run in zbm (ADR 0017).
    | _zbm_zfunc() {
    |   (
    |     export BASE BOOTFS CLEAR_SCREEN DRACUT_VERSION ENABLED FORCE_RELOAD HOME 2>/dev/null
    |     export ID ID_LIKE INITRD_VERSION NO_CACHE PRETTY_NAME PROMOTE PROPERTY 2>/dev/null
    |     export UNAME VALUE VERSION VERSION_ID ZBM_PRETTY_NAME ZBM_RELEASE_BUILD 2>/dev/null
    |     export ZBM_VERSION _pool adds allow_rw arg args beloc cache candidates cf 2>/dev/null
    |     export checkpoint cli_args color dataset decision def delay dev device 2>/dev/null
    |     export dtb_file dtb_prop dtb_try efivar_location efivar_state encroot 2>/dev/null
    |     export environment error_line ext f filesystem force_export fs grep_args 2>/dev/null
    |     export hdir hfile hook hook_envs hook_fs hook_mount hook_path hook_root 2>/dev/null
    |     export hostid hostid_re hsrc i id ifile import_args import_output 2>/dev/null
    |     export import_policy importable infinite inherited initramfs ipath k karg 2>/dev/null
    |     export kcl kcl_path kclfile kdir kern kern_kcl kernel kernel_list 2>/dev/null
    |     export kernel_records kexec_args key keycache keydest keydir keyfile 2>/dev/null
    |     export keyformat keylocation keypath keysource keysrc keystatus kkey kopt 2>/dev/null
    |     export kpath ksmount kval kver lbl lc level levels levels_array line 2>/dev/null
    |     export lines load_success loglevel mes message mnt mount_dev mount_path 2>/dev/null
    |     export mountpoint mounts mp mp_re mutex opt opts osrel ostype output 2>/dev/null
    |     export par_args parent parfs path pfx pool prefix prohibited prompt 2>/dev/null
    |     export read_write readargs recv_args relkeyloc rem rems ret 2>/dev/null
    |     export rewind_to_checkpoint roflag root_prefix rwo selected since single 2>/dev/null
    |     export snap snapshot spec_kexec_args specific_kernel spl_hostid splmod 2>/dev/null
    |     export state stype sup target target_parent trace val x y zbm_prefer_pool 2>/dev/null
    |     export zbm_set_hostid zfsbe zfsbe_fs zfsbe_mnt 2>/dev/null
    |     exec /libexec/zbm zfunc "$@"
    |   )
    | }
    | 
    | zdebug() {
    |   [ "${loglevel:-4}" -ge 7 ] || return 1
    |   local prefix trace last lines line lc i
    | 
    |   # Remove everything but new lines from the string, count the length
    |   lines="${1//[!$'\n']/}"
    |   lines="${#lines}"
    | 
    |   while IFS=$'\n' read -r line ; do
    |     if [ "${lc:=0}" -eq "${lines}" ] ; then
    |       trace=
    |       last=${#BASH_SOURCE[@]}
    |       for (( i=1 ; i<last ; i++ )) ; do
    |         trace="${FUNCNAME[$i]},${BASH_SOURCE[$i]},${BASH_LINENO[$i-1]}${trace:+;}${trace}"
    |       done
    |       prefix="<7>ZBM:[$$]|${trace}|"
    |     else
    |       prefix="<7>ZBM:[$$]||"
    |     fi
    |     lc=$(( lc + 1 ))
    |     echo "${prefix}${line}" > /dev/kmsg
    |   done <<<"${1}"
    | }
    | 
    | if [ "${loglevel:-4}" -ge 7 ] ; then
    |   # Trap errors and send them to the debug handler
    |   traperror() {
    |     zdebug "trapped error from: '${BASH_COMMAND}'"
    |   }
    | 
    |   trap traperror ERR
    |   set -o errtrace
    | fi
    | 
    | # arg1: log line
    | # prints: nothing
    | # returns: 1 if loglevel isn't high enough
    | 
    | zinfo() {
    |   [ "${loglevel:-4}" -ge 6 ] || return 1
    |   echo "<6>ZFSBootMenu: $1" > /dev/kmsg
    | }
    | 
    | # arg1: log line
    | # prints: nothing
    | # returns: 1 if loglevel isn't high enough
    | 
    | znotice() {
    |   [ "${loglevel:-4}" -ge 5 ] || return 1
    |   echo "<5>ZFSBootMenu: $1" > /dev/kmsg
    | }
    | 
    | # arg1: log line
    | # prints: nothing
    | # returns: 1 if loglevel isn't high enough
    | 
    | zwarn() {
    |   [ "${loglevel:-4}" -ge 4 ] || return 1
    |   : > "${BASE}/have_warnings"
    |   echo "<4>ZFSBootMenu: $1" > /dev/kmsg
    | }
    | 
    | # arg1: log line
    | # prints: nothing
    | # returns: 1 if loglevel isn't high enough
    | 
    | zerror() {
    |   [ "${loglevel:-4}" -ge 3 ] || return 1
    |   : > "${BASE}/have_errors"
    |   echo "<3>ZFSBootMenu: $1" > /dev/kmsg
    | }
    | 
    | # arg1: comma-separated log levels to print
    | # arg2: optional date that messages must be timestamped after
    | # prints: all logs at that level
    | # returns: nothing
    | 
    | print_kmsg_logs() {
    |   _zbm_zfunc print_kmsg_logs "$@"
    | }
    | 
