# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.{rs,py,toml}]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

# Markdown uses trailing spaces for line breaks
[*.md]
trim_trailing_whitespace = false

# Generated or binary files
[{legacy/zfsbootmenu/help-files/**,docs/man/dist/**,*.bmp,*.png,*.svg}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
max_line_length = unset
