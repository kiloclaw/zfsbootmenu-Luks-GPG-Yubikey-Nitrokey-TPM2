# syntax=docker/dockerfile:1.4
#
# This Dockerfile creates an Ubuntu-based container that builds ZFSBootMenu
# EFI executables and kernel/initramfs components, as an alternative to the
# Void Linux container described by ./Dockerfile. Build it with
#
#   docker build -f releng/docker/Dockerfile.ubuntu -t zbm-builder:ubuntu releng/docker
#
# and use it exactly like the Void container, for example with
#
#   ./zbm-builder.sh -i zbm-builder:ubuntu
#
# Differences from the Void container:
#
# - The kernel and the ZFS module are Ubuntu's own packages. Ubuntu builds the
#   module for each kernel (linux-main-modules-zfs-*), so no DKMS build or
#   kernel headers are needed.
# - The kernel series follows the Ubuntu release: Ubuntu 26.10 ships Linux 7.3
#   and OpenZFS 2.4.4. The container records its kernel in
#   /etc/zbm-kernel-version and build-init.sh selects it by default.
# - Images are built with dracut only; Ubuntu does not package mkinitcpio.
# - systemd's cryptsetup token plugins are installed, so images can use them
#   to unlock TPM2 tokens with signed PCR policies or pcrlock, which
#   ZFSBootMenu's own TPM2 code does not support.
#
# Note - this Dockerfile depends on Docker >= 23 and the docker buildx plugin.

# Ubuntu 26.10 or later: earlier releases do not package yq-go, which
# build-init.sh needs
ARG UBUNTU_RELEASE=26.10
FROM ubuntu:${UBUNTU_RELEASE}
LABEL org.opencontainers.image.authors="ZFSBootMenu Team, https://zfsbootmenu.org"

# Ubuntu kernel flavour to install; the matching kernel image, modules and ZFS
# module packages are installed without the firmware and microcode packages,
# which an EFI boot loader does not need
ARG KERNEL_FLAVOUR=generic

ENV DEBIAN_FRONTEND=noninteractive

RUN <<-EOF
	set -e

	# Keep kernel postinst hooks from building an unused initramfs in /boot,
	# like the noextract rules in the Void container
	cat > /etc/dpkg/dpkg.cfg.d/90-zbm-noinitramfs <<-CFG
		path-exclude=/etc/kernel/postinst.d/dracut
		path-exclude=/etc/kernel/postinst.d/initramfs-tools
		path-exclude=/etc/kernel/postinst.d/zz-update-grub
		path-exclude=/usr/lib/kernel/install.d/*dracut*
	CFG

	apt-get update
	apt-get -y dist-upgrade

	# Resolve the kernel packages of the flavour: the kernel image and its
	# module packages, which include the ZFS module (a separate
	# linux-main-modules-zfs-* package since Ubuntu 26.04), but not the
	# firmware and microcode the metapackage also pulls in
	kpkgs="$(apt-cache depends "linux-image-${KERNEL_FLAVOUR}" \
		| sed -n 's/^ *Depends: \(linux-[^<>]*\)$/\1/p' | grep -v '^linux-firmware')"
	kabi="$(printf '%s\n' ${kpkgs} | sed -n 's/^linux-image-\([0-9].*\)$/\1/p' | head -n 1)"
	if [ -z "${kabi}" ]; then
		echo "ERROR: no kernel found for flavour '${KERNEL_FLAVOUR}'"
		exit 1
	fi

	# Install the kernel, ZFS and the ZFSBootMenu dependencies; the list
	# mirrors the Void container's
	apt-get -y install --no-install-recommends ${kpkgs} zfsutils-linux \
		dracut-core dracut-network systemd-boot-efi systemd-cryptsetup \
		libsort-versions-perl libboolean-perl libyaml-pp-perl \
		libconfig-inifiles-perl fzf mbuffer kexec-tools bsdextrautils \
		ncurses-bin procps kmod udev zstd binutils curl ca-certificates \
		yq-go bash kbd gdisk iproute2 iputils-ping parted dosfstools \
		e2fsprogs efibootmgr cryptsetup-bin openssh-client util-linux \
		util-linux-extra less kpartx gnupg scdaemon libfido2-1 fido2-tools \
		clevis clevis-luks clevis-tpm2 tpm2-tools yubikey-personalization \
		openssl

	# The ZFS module must exist for the installed kernel
	if ! modinfo -k "${kabi}" zfs >/dev/null; then
		echo "ERROR: kernel ${kabi} has no ZFS module"
		exit 1
	fi

	# Select this kernel by default in build-init.sh
	kver="${kabi%%-*}"
	echo "${kver%.*}.*" > /etc/zbm-kernel-version

	# Hold the kernel and ZFS so that build-init.sh -u keeps them
	apt-mark hold ${kpkgs} $(dpkg-query -W -f '${Package}\n' \
		| grep -E '^(zfsutils-linux|libzfs|libzpool|libnvpair|libuutil)')

	# Leave only versioned kernel files in /boot
	rm -f /boot/initrd.img* /boot/initramfs* /boot/vmlinuz /boot/vmlinuz.old
	apt-get clean
	rm -rf /var/lib/apt/lists/*
	EOF

# ZFSBootMenu commit hash, tag or branch name used by
# default to build ZFSBootMenu images (default: master)
ARG ZBM_COMMIT_HASH=
# Record a commit hash if one was provided
RUN [ -z "${ZBM_COMMIT_HASH}" ] || echo "${ZBM_COMMIT_HASH}" > /etc/zbm-commit-hash

# Include the specified Ubuntu packages in the image
# (multiple entries must be separated by spaces)
ARG PACKAGES=
# Install ${PACKAGES} in a separate layer so that the kernel layer is reused
RUN [ -z "${PACKAGES}" ] || { apt-get update && \
	apt-get -y install --no-install-recommends ${PACKAGES} && \
	apt-get clean && rm -rf /var/lib/apt/lists/*; }

ARG ZBM_BUILDER=build-init.sh
# Install the build script under a fixed name: variables are not expanded in
# the exec form of ENTRYPOINT
COPY --chmod=755 ${ZBM_BUILDER} /build-init.sh
# Run the build script with no arguments by default
ENTRYPOINT [ "/build-init.sh" ]
