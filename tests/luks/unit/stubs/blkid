#!/bin/bash
# Stub: report fake contents for /dev/mapper/*, otherwise real blkid. Device
# searches (-o device) only find the suites' loop devices, so that discovery
# leaves the host's own LUKS disks alone.
search=
prev=
for a in "$@"; do
  case "$a" in
    /dev/mapper/*)
      n=${a#/dev/mapper/}; dev=$(cat "$FAKE/maps/$n" 2>/dev/null) || exit 2
      f="$FAKE/content/$(basename "$(readlink -f "$dev")")"
      [ -r "$f" ] && cat "$f"; exit 0 ;;
    device) [ "$prev" = "-o" ] && search=1 ;;
  esac
  prev=$a
done
[ -n "$search" ] || exec /usr/sbin/blkid "$@"
found=$(/usr/sbin/blkid "$@" | grep '^/dev/loop')
[ -n "$found" ] || exit 2
printf '%s\n' "$found"
