#!/bin/bash

# The ZFSBootMenu mkinitcpio hook: zbm decides what goes into the image (`zbm
# image plan`, ROADMAP.md SB8, docs/dev/adr/0006-image-plan.md), and this
# hook installs it with mkinitcpio's functions. The plan is a manifest of
# tab-separated lines.

# Prints the build's settings for zbm, a line each: NAME<TAB>VALUE for a
# variable, NAME[]<TAB>VALUE for each element of an array.
zbm_settings() {
    local name value attributes
    for name in $( compgen -v zfsbootmenu_ ) SOURCE_DATE_EPOCH PATH; do
        attributes="$( declare -p "${name}" 2>/dev/null )" || continue
        attributes="${attributes#declare -}"
        if [[ "${attributes%% *}" == *a* ]]; then
            local -n zbm_array="${name}"
            for value in "${zbm_array[@]}"; do
                printf '%s[]\t%s\n' "${name}" "${value//$'\n'/ }"
            done
            unset -n zbm_array
        else
            value="${!name}"
            printf '%s\t%s\n' "${name}" "${value//$'\n'/ }"
        fi
    done
}

# Adds a kernel module only if the kernel has it as a loadable file;
# otherwise, ignores it.
add_optional_module() {
    # Without a version, no module is added
    [[ $KERNELVERSION == none ]] && return 0

    # The test is inverted so that mkinitcpio's RETURN trap does not trip on
    # a module that does not exist
    local kfile
    if ! kfile="$( modinfo -k "${KERNELVERSION}" -n "${1}" 2>/dev/null )"; then
        return 0
    fi
    case "${kfile}" in
        /*) add_module "${1}" ;;
        *) return 0 ;;
    esac
}

# Installs a line of the manifest; returns 1 when the build cannot go on.
zbm_install_line() {
    local kind="${1}" one="${2}" two="${3}" three="${4}"
    case "${kind}" in
        dir) add_dir "${one}" "${two}" ;;
        file)
            if [ "${three}" = - ]; then
                add_file "${one}" "${two}"
            else
                add_file "${one}" "${two}" "${three}"
            fi || { error "failed to install file '${one}'"; return 1; }
            ;;
        link) add_symlink "${two}" "${one}" ;;
        hardlink)
            mkdir -p "${BUILDROOT}${two%/*}" && ln -f "${BUILDROOT}${one}" "${BUILDROOT}${two}"
            ;;
        binary) add_binary "${one}" "${two}" || { error "failed to install '${one}'"; return 1; } ;;
        library) add_binary "${one}" || { error "failed to install '${one}'"; return 1; } ;;
        module)
            if [ "${two}" = required ]; then
                add_module "${one}" || { error "required kernel module '${one}' is missing"; return 1; }
            else
                add_optional_module "${one}"
            fi
            ;;
        rule)
            if ! add_udev_rule "${one}"; then
                [ "${two}" = required ] && { error "failed to install udev rule '${one}'"; return 1; }
                warning "failed to install udev rule '${one}'"
            fi
            ;;
        firmware)
            # shellcheck disable=SC2154
            "${zfsbootmenu_zbm}" image prune-firmware "${BUILDROOT}" "${one}" "${two}" || {
                error "Unable to install the graphics firmware"
                return 1
            }
            ;;
        info) msg2 "${one}" ;;
        warn) warning "${one}" ;;
    esac
    return 0
}

build() {
    local plan kind one two three

    : "${zfsbootmenu_zbm:=/usr/libexec/zfsbootmenu/zbm}"
    if [ ! -x "${zfsbootmenu_zbm}" ]; then
        error "zbm, which plans every ZFSBootMenu image, is not at ${zfsbootmenu_zbm} (zfsbootmenu_zbm)"
        exit 1
    fi

    plan="$( mktemp -d )" || exit 1
    zbm_settings > "${plan}/settings"
    if ! "${zfsbootmenu_zbm}" image plan --builder mkinitcpio --config "${plan}/settings" \
        --stage "${plan}/stage" > "${plan}/manifest"; then
        error "Unable to plan the ZFSBootMenu image"
        rm -rf "${plan}"
        exit 1
    fi

    while IFS=$'\t' read -r kind one two three; do
        zbm_install_line "${kind}" "${one}" "${two}" "${three}" || { rm -rf "${plan}"; exit 1; }
    done < "${plan}/manifest"
    rm -rf "${plan}"

    add_runscript
}

help() {
    echo "This hook turns the initramfs into a ZFSBootMenu image"
}

